http_port {{ squid_port }}

acl localnet src {{ squid_allowed_cidr }}

acl SSL_ports port 443
acl Safe_ports port 80
acl Safe_ports port 443
acl CONNECT method CONNECT

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow localhost
http_access allow localnet
http_access deny all

# 1 行 = 1 接続。CONNECT トンネルなので見えるのは「誰が・どこへ・何バイト・何ms」まで（トークン数は取れない）
logformat hermes %ts.%03tu client=%>a method=%rm dest=%ru status=%Ss/%>Hs sent=%>st recv=%<st ms=%tr peer=%<a
access_log /var/log/squid/access.log hermes
